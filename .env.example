# ============================================
# Laxigam Blockchain - Environment Variables
# ============================================

# --------------------------------------------
# Database Configuration
# --------------------------------------------
DATABASE_URL=postgresql://laxigam:laxigam_password@localhost:5432/laxigam
DB_PASSWORD=laxigam_secure_password

# --------------------------------------------
# Blockchain Configuration
# --------------------------------------------
NETWORK=polygon
RPC_URL=https://polygon-rpc.com
MUMBAI_RPC_URL=https://rpc-mumbai.maticvigil.com
CHAIN_ID=137
DEPLOYER_PRIVATE_KEY=0x...

# Contract Addresses (after deployment)
LXG_TOKEN_ADDRESS=0x...
GAME_BRIDGE_ADDRESS=0x...
TRUST_SCORE_ADDRESS=0x...
AI_VALIDATOR_ADDRESS=0x...
NFT_MARKETPLACE_ADDRESS=0x...
GOVERNANCE_ADDRESS=0x...

# --------------------------------------------
# AI API Keys
# --------------------------------------------
GEMINI_API_KEY=AIzaSy...
ANTHROPIC_API_KEY=sk-ant-api03-...
AI_MODE=hybrid

# --------------------------------------------
# Telegram Configuration
# --------------------------------------------
TELEGRAM_BOT_TOKEN=7123456789:AAH...
TELEGRAM_PAYMENT_TOKEN=...
TELEGRAM_MINI_APP_URL=https://laxigam.app

# --------------------------------------------
# Payment Gateway Keys
# --------------------------------------------
# India - Razorpay
RAZORPAY_KEY_ID=rzp_...
RAZORPAY_SECRET=...

# Brazil - Mercado Pago
MERCADOPAGO_ACCESS_TOKEN=APP_USR-...

# Russia - QIWI
QIWI_SECRET_KEY=...
QIWI_PUBLIC_KEY=...

# China - Alipay
ALIPAY_APP_ID=...
ALIPAY_PRIVATE_KEY=...
ALIPAY_PUBLIC_KEY=...

# Global - Stripe
STRIPE_SECRET_KEY=sk_...
STRIPE_WEBHOOK_SECRET=whsec_...

# --------------------------------------------
# TON Network
# --------------------------------------------
TON_API_KEY=...
TON_BRIDGE_CONTRACT_ADDRESS=EQ...
LXG_TON_WALLET=EQ...
TON_TO_LXG_RATE=100

# --------------------------------------------
# Telegram Stars
# --------------------------------------------
STARS_TO_LXG_RATE=0.1

# --------------------------------------------
# Security
# --------------------------------------------
API_SECRET_KEY=your_super_secret_key_change_this
JWT_SECRET=your_jwt_secret_key_change_this
ENCRYPTION_KEY=your_encryption_key_32chars!!

# --------------------------------------------
# Exchange Rates
# --------------------------------------------
LXG_USD_RATE=0.05
UPDATE_RATES_INTERVAL=300

# CoinMarketCap (for price feeds)
COINMARKETCAP_API_KEY=...

# --------------------------------------------
# API Keys for Verification
# --------------------------------------------
ETHERSCAN_API_KEY=...
POLYGONSCAN_API_KEY=...

# --------------------------------------------
# Application Settings
# --------------------------------------------
DEBUG=false
LOG_LEVEL=INFO
CORS_ORIGINS=http://localhost:3000,https://laxigam.app

# --------------------------------------------
# Ports
# --------------------------------------------
BACKEND_PORT=8000
FRONTEND_PORT=3000

# --------------------------------------------
# Redis (for caching)
# --------------------------------------------
REDIS_URL=redis://localhost:6379/0

# --------------------------------------------
# Sentry (error tracking)
# --------------------------------------------
SENTRY_DSN=https://...@sentry.io/...

# --------------------------------------------
# AWS S3 (for file storage)
# --------------------------------------------
AWS_ACCESS_KEY_ID=...
AWS_SECRET_ACCESS_KEY=...
AWS_STORAGE_BUCKET_NAME=laxigam-storage
AWS_S3_REGION_NAME=us-east-1
